{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PaperGo solution locale",
  "description": "A solution's display names in one language: locales/<language>.json. What it leaves out keeps the solution's own text.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "name": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "description": "By setting name.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "title": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "fields": {
      "type": "object",
      "description": "By field key.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "label": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "content_types": {
      "type": "object",
      "description": "Names by content type key.",
      "additionalProperties": {
        "type": "string"
      }
    },
    "collections": {
      "type": "object",
      "description": "By collection key.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "views": {
            "type": "object",
            "description": "Names by view key.",
            "additionalProperties": {
              "type": "string"
            }
          }
        }
      }
    },
    "workflows": {
      "type": "object",
      "description": "By workflow key.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    },
    "apps": {
      "type": "object",
      "description": "By app key.",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        }
      }
    }
  }
}
