{
  "compilerOptions": {
    "target": "ES2020",
    "lib": [
      "ES2022"
    ],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "paths": {
      "@papergo/workflow": [
        "./src/index.ts"
      ]
    }
  },
  "include": [
    "src",
    "test",
    "../internal/workflow/builtin",
    "../samples"
  ]
}
