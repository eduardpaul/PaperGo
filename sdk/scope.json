{
  "$comment": "API paths a workflow script cannot call. The client generator leaves them out and the engine refuses them. * matches one path segment and ** any number of them, but at least one.",
  "exclude": [
    "/auth",
    "/auth/**",
    "/health",
    "/health/**",
    "/v1/$batch",
    "/v1/events",
    "/v1/identity",
    "/v1/identity/**",
    "/v1/me",
    "/v1/me/**",
    "/v1/organization",
    "/v1/organization/**",
    "/v1/portability",
    "/v1/portability/**",
    "/v1/storage",
    "/v1/storage/**",
    "/v1/workflow-catalog",
    "/v1/workflow-runs",
    "/v1/workflow-runs/**",
    "/v1/workflow-waits",
    "/v1/workflow-waits/**",
    "/v1/workflows",
    "/v1/workflows/**",
    "/v1/resources/*/workflow-roles",
    "/v1/workspaces/*/workflow-actions",
    "/v1/workspaces/*/workflow-builtins",
    "/v1/workspaces/*/workflow-builtins/**",
    "/v1/workspaces/*/workflow-runs",
    "/v1/workspaces/*/workflows"
  ]
}
