{
  "version": "1.0.0",
  "clients": {
    "PaperGoClient": {
      "language": "TypeScript",
      "typeAccessModifier": "Public",
      "structuredMimeTypes": [
        "application/json",
        "text/plain;q=0.9",
        "application/x-www-form-urlencoded;q=0.2",
        "multipart/form-data;q=0.1"
      ],
      "clientNamespaceName": "PaperGo",
      "usesBackingStore": false,
      "includeAdditionalData": false,
      "excludeBackwardCompatible": true,
      "disabledValidationRules": [],
      "descriptionLocation": "/home/user/PaperGo/api/openapi.json",
      "includePatterns": [],
      "excludePatterns": [
        "/auth",
        "/auth/**",
        "/health",
        "/health/**",
        "/v1/$batch",
        "/v1/events",
        "/v1/identity",
        "/v1/identity/**",
        "/v1/me",
        "/v1/me/**",
        "/v1/organization",
        "/v1/organization/**",
        "/v1/portability",
        "/v1/portability/**",
        "/v1/storage",
        "/v1/storage/**",
        "/v1/workflow-catalog",
        "/v1/workflow-runs",
        "/v1/workflow-runs/**",
        "/v1/workflow-waits",
        "/v1/workflow-waits/**",
        "/v1/workflows",
        "/v1/workflows/**",
        "/v1/resources/*/workflow-roles",
        "/v1/workspaces/*/workflow-actions",
        "/v1/workspaces/*/workflow-builtins",
        "/v1/workspaces/*/workflow-builtins/**",
        "/v1/workspaces/*/workflow-runs",
        "/v1/workspaces/*/workflows"
      ],
      "allowedExternalOrigins": [],
      "outputPath": "./src/client"
    }
  },
  "plugins": {}
}