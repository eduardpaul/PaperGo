# The application reads environment variables; it does not load this file itself.
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=data/papergo.db
BLOB_PATH=data/blobs
AUTH_MODE=development
# Generate your own random token of at least 32 characters.
DEV_TOKEN=
DEV_SUBJECT=local-admin
MAX_UPLOAD_BYTES=67108864

# Production: APP_ENV=production and AUTH_MODE=oidc, with these values set.
OIDC_ISSUER=
OIDC_AUDIENCE=
