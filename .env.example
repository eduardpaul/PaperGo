# The application reads environment variables; it does not load this file itself.
# Optional configuration file (default: ./config.yaml); non-empty environment variables override YAML.
# PAPERGO_CONFIG=/path/to/config.yaml
# Local authentication uses ADMIN_SUBJECT (default: admin) and the initial ADMIN_PASSWORD (development default: admin; required in production).
# ADMIN_PASSWORD=
APP_ENV=development
HTTP_ADDR=127.0.0.1:8080
DATABASE_PATH=data/papergo.db
BLOB_PATH=data/blobs
AUTH_MODE=development
# Generate your own random token of at least 32 characters.
DEV_TOKEN=
DEV_SUBJECT=local-admin
MAX_UPLOAD_BYTES=67108864
# Concurrent API requests before new ones are shed with 503 + Retry-After.
MAX_IN_FLIGHT=32
# API reads, including typed query POSTs, running longer are cancelled (503). Mutations and blob transfers are exempt.
REQUEST_TIMEOUT=30s
# Workflow runner: this process's identity (it recovers its own runs after a restart) and how long finished runs are kept.
NODE_ID=local
RUN_RETENTION=720h

# Behind a TLS-terminating reverse proxy: the origin clients use (https://docs.example.com, no path).
# Absolute links (@odata.nextLink) use it, and WebDAV COPY/MOVE accept it in Destination. Production requires https.
PUBLIC_URL=

# OIDC production: APP_ENV=production and AUTH_MODE=oidc, with these values set.
OIDC_ISSUER=
OIDC_AUDIENCE=
# First organization administrator: exactly one of ADMIN_SUBJECT or ADMIN_GROUP is required in OIDC mode.
# Development authentication defaults ADMIN_SUBJECT to DEV_SUBJECT.
ADMIN_SUBJECT=
# ADMIN_GROUP=papergo-admins

# Group sync: claim holding group names (string array, comma-separated string, or dotted path e.g. realm_access.roles).
# OIDC_GROUPS_CLAIM=
# Optional prefix stripped when syncing groups (e.g. papergo-).
# OIDC_GROUPS_PREFIX=

# Web app sign-in at the provider: a public client (authorization code with PKCE) with the redirect URI
# <PUBLIC_URL>/login/callback and the sign-out redirect <PUBLIC_URL>/login. Empty: paste tokens instead.
# OIDC_CLIENT_ID=
# Scopes the web app requests (default: openid profile email offline_access).
# OIDC_CLIENT_SCOPES=

# Optional access token type check (e.g. at+jwt).
# OIDC_TOKEN_TYPE=

# Fetch groups from UserInfo endpoint if absent from access token (true/false).
# OIDC_GROUPS_FROM_USERINFO=false

# NPM-only production: AUTH_MODE=proxy, ADMIN_SUBJECT=<access-list username>, PUBLIC_URL=https://docs.example.com
# PROXY_SECRET_FILE=/run/secrets/papergo-proxy-secret
# PROXY_TRUSTED_CIDRS=172.29.242.2/32
# The proxy overwrites identity headers; PaperGo's backend port must remain private.

# Local administrator secret-file alternative (do not also set ADMIN_PASSWORD):
# ADMIN_PASSWORD_FILE=/run/secrets/admin-password
