{
  "key": "receipts",
  "name": "Receipts desk",
  "description": "Photos of purchase receipts and the lines read from them.",
  "version": "1.0.2",
  "requires": {
    "ai.batch": true,
    "ocr": false
  },
  "fields": [
    {
      "key": "receipts_store",
      "label": "Store",
      "type": "text",
      "indexed": true,
      "options": {
        "max_length": 200
      }
    },
    {
      "key": "receipts_purchase_date",
      "label": "Purchase date",
      "type": "date",
      "indexed": true
    },
    {
      "key": "receipts_currency",
      "label": "Currency",
      "type": "text",
      "indexed": true,
      "options": {
        "max_length": 3
      }
    },
    {
      "key": "receipts_total",
      "label": "Total",
      "type": "decimal",
      "scale": 2,
      "indexed": true
    },
    {
      "key": "receipts_status",
      "label": "Status",
      "type": "choice",
      "indexed": true,
      "choices": [
        "New",
        "Read",
        "Needs review"
      ],
      "options": {
        "default_value": "New"
      }
    },
    {
      "key": "receipts_problem",
      "label": "Problem",
      "type": "choice",
      "choices": [
        "Not a photo",
        "Not readable",
        "Not filed",
        "No PDF",
        "Changed"
      ]
    },
    {
      "key": "receipts_description",
      "label": "Description",
      "type": "text",
      "options": {
        "max_length": 200
      }
    },
    {
      "key": "receipts_category",
      "label": "Category",
      "type": "choice",
      "indexed": true,
      "choices": [
        "Fruit and vegetables",
        "Meat and fish",
        "Dairy and eggs",
        "Bakery",
        "Pantry",
        "Frozen",
        "Drinks",
        "Snacks and sweets",
        "Household",
        "Personal care",
        "Health",
        "Baby",
        "Pets",
        "Other"
      ]
    },
    {
      "key": "receipts_quantity",
      "label": "Quantity",
      "type": "decimal",
      "scale": 4
    },
    {
      "key": "receipts_unit_price",
      "label": "Unit price",
      "type": "decimal",
      "scale": 4
    },
    {
      "key": "receipts_amount",
      "label": "Amount",
      "type": "decimal",
      "scale": 2,
      "indexed": true
    }
  ],
  "content_types": [
    {
      "key": "receipts_receipt",
      "name": "Receipt",
      "fields": [
        "receipts_store",
        "receipts_purchase_date",
        "receipts_currency",
        "receipts_total",
        "receipts_status",
        "receipts_problem"
      ]
    },
    {
      "key": "receipts_line",
      "name": "Receipt line",
      "fields": [
        "receipts_description",
        "receipts_category",
        "receipts_quantity",
        "receipts_unit_price",
        "receipts_amount",
        "receipts_currency",
        "receipts_purchase_date",
        "receipts_status"
      ]
    }
  ],
  "relationship_types": [
    {
      "name": "contains receipt line",
      "inverse_label": "belongs to receipt",
      "directed": true,
      "max_incoming": 1
    }
  ],
  "collections": [
    {
      "key": "receipts",
      "kind": "library",
      "name": "Receipts",
      "content_types": [
        "receipts_receipt",
        "receipts_line"
      ],
      "webdav_enabled": true,
      "views": [
        {
          "key": "receipts",
          "name": "Receipts",
          "layout": "table",
          "is_default": true,
          "columns": [
            "$name",
            "receipts_store",
            "receipts_purchase_date",
            "receipts_currency",
            "receipts_total",
            "receipts_status"
          ],
          "query": {
            "content_type_id": "$type:receipts_receipt",
            "filter": {
              "field": "receipts_status",
              "op": "present"
            },
            "sort": [
              {
                "field": "receipts_purchase_date",
                "direction": "desc"
              }
            ]
          }
        },
        {
          "key": "needs-review",
          "name": "Needs review",
          "layout": "table",
          "columns": [
            "$name",
            "receipts_store",
            "receipts_purchase_date",
            "receipts_currency",
            "receipts_total",
            "receipts_status",
            "receipts_problem"
          ],
          "query": {
            "content_type_id": "$type:receipts_receipt",
            "filter": {
              "field": "receipts_status",
              "op": "eq",
              "value": "Needs review"
            }
          }
        },
        {
          "key": "lines",
          "name": "Lines",
          "layout": "table",
          "columns": [
            "$name",
            "receipts_description",
            "receipts_category",
            "receipts_quantity",
            "receipts_unit_price",
            "receipts_amount",
            "receipts_currency",
            "receipts_purchase_date",
            "receipts_status"
          ],
          "query": {
            "content_type_id": "$type:receipts_line"
          }
        }
      ]
    }
  ]
}
