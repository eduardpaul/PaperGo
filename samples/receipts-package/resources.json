{
  "workspace": {
    "name": "Receipts desk",
    "description": "Photos of purchase receipts and the lines read from them."
  },
  "fields": [
    {"key": "store", "label": "Store", "type": "text", "indexed": true, "options": {"max_length": 200}},
    {"key": "purchase_date", "label": "Purchase date", "type": "date", "indexed": true},
    {"key": "currency", "label": "Currency", "type": "text", "indexed": true, "options": {"max_length": 3}},
    {"key": "total", "label": "Total", "type": "decimal", "scale": 2, "indexed": true},
    {"key": "status", "label": "Status", "type": "choice", "indexed": true, "choices": ["New", "Read", "Needs review"], "options": {"default_value": "New"}},
    {"key": "description", "label": "Description", "type": "text", "options": {"max_length": 200}},
    {"key": "category", "label": "Category", "type": "choice", "indexed": true, "choices": ["Fruit and vegetables", "Meat and fish", "Dairy and eggs", "Bakery", "Pantry", "Frozen", "Drinks", "Snacks and sweets", "Household", "Personal care", "Health", "Baby", "Pets", "Other"]},
    {"key": "quantity", "label": "Quantity", "type": "decimal", "scale": 4},
    {"key": "unit_price", "label": "Unit price", "type": "decimal", "scale": 4},
    {"key": "amount", "label": "Amount", "type": "decimal", "scale": 2, "indexed": true}
  ],
  "content_types": [
    {"key": "receipt", "name": "Receipt", "fields": ["store", "purchase_date", "currency", "total", "status"]},
    {"key": "receipt_line", "name": "Receipt line", "fields": ["description", "category", "quantity", "unit_price", "amount", "currency", "purchase_date"]}
  ],
  "collections": [
    {
      "name": "Receipts",
      "kind": "library",
      "webdav_enabled": true,
      "content_types": ["receipt", "receipt_line"],
      "views": [
        {
          "name": "Receipts",
          "layout": "table",
          "is_default": true,
          "columns": ["$name", "store", "purchase_date", "currency", "total", "status"],
          "query": {"content_type_id": "$receipt", "filter": {"field": "status", "op": "present"}, "sort": [{"field": "purchase_date", "direction": "desc"}]}
        },
        {
          "name": "Needs review",
          "layout": "table",
          "columns": ["$name", "store", "purchase_date", "currency", "total", "status"],
          "query": {"content_type_id": "$receipt", "filter": {"field": "status", "op": "eq", "value": "Needs review"}}
        },
        {
          "name": "Lines",
          "layout": "table",
          "columns": ["$name", "description", "category", "quantity", "unit_price", "amount", "currency", "purchase_date"],
          "query": {"content_type_id": "$receipt_line"}
        }
      ]
    }
  ],
  "relationship": {
    "name": "contains receipt line",
    "inverse_label": "belongs to receipt",
    "directed": true,
    "max_incoming": 1
  }
}
