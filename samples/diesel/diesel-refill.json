{
  "key": "diesel-refill",
  "name": "Diesel refill",
  "description": "Asks the buyers to fill the tank when a reading falls below threshold_l; the purchase answers it.",
  "script": "diesel-refill.ts",
  "parameters": {
    "list": "$LIST",
    "reading_type": "$READING_TYPE",
    "purchase_type": "$PURCHASE_TYPE",
    "threshold_l": 200,
    "buyers": [
      "role:owners"
    ]
  },
  "automatic_enabled": true,
  "manual_enabled": true,
  "state": "published"
}
