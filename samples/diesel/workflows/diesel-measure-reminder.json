{
  "key": "diesel-measure-reminder",
  "name": "Diesel measuring reminder",
  "description": "Asks someone to measure the tank when the last reading is older than every_days; a reading filed any other way closes the task.",
  "script": "diesel-measure-reminder.ts",
  "parameters": {
    "list": "$collection:tank",
    "reading_type": "$type:diesel_reading",
    "every_days": 15,
    "assignees": [
      "role:owners"
    ],
    "time_zone": "$setting:time_zone",
    "stick_length_cm": 200
  },
  "automatic_enabled": true,
  "manual_enabled": true,
  "state": "published"
}
