{
  "workspace": {
    "name": "Diesel tracker",
    "description": "Dipstick readings, purchases and heating of a diesel tank, with what is left, what it costs and when to buy."
  },
  "fields": [
    {"key": "diesel_measured_at", "label": "Measured at", "type": "datetime", "required": true, "indexed": true},
    {"key": "diesel_stick_cm", "label": "Stick reading (cm)", "type": "decimal", "scale": 1, "required": true, "indexed": true, "options": {"minimum": "0", "description": "The length of the stick from the filling mouth down to the diesel."}},
    {"key": "diesel_level_liters", "label": "Litres", "type": "decimal", "scale": 1, "indexed": true, "options": {"description": "Worked out from the stick by the Diesel levels workflow."}},
    {"key": "diesel_fill_percent", "label": "Fill %", "type": "decimal", "scale": 1, "indexed": true},
    {"key": "diesel_flag", "label": "Check", "type": "choice", "indexed": true, "choices": ["ok", "check", "reviewed"], "options": {"description": "check: higher than the last reading and what was bought since. Set reviewed once it is confirmed."}},
    {"key": "diesel_purchased_at", "label": "Bought at", "type": "datetime", "required": true, "indexed": true},
    {"key": "diesel_bought_liters", "label": "Litres bought", "type": "decimal", "scale": 1, "required": true, "indexed": true, "options": {"minimum": "0"}},
    {"key": "diesel_total_price", "label": "Total price", "type": "currency", "required": true, "indexed": true, "options": {"currency_code": "EUR", "minimum": "0"}},
    {"key": "diesel_price_per_liter", "label": "Price per litre", "type": "decimal", "scale": 3, "indexed": true},
    {"key": "diesel_supplier", "label": "Supplier", "type": "text", "options": {"max_length": 200}},
    {"key": "diesel_heating_at", "label": "Changed at", "type": "datetime", "required": true, "indexed": true},
    {"key": "diesel_heating", "label": "Heating", "type": "choice", "required": true, "indexed": true, "choices": ["on", "off"]}
  ],
  "content_types": [
    {"key": "diesel_reading", "name": "Reading", "fields": ["diesel_measured_at", "diesel_stick_cm", "diesel_level_liters", "diesel_fill_percent", "diesel_flag"]},
    {"key": "diesel_purchase", "name": "Purchase", "fields": ["diesel_purchased_at", "diesel_bought_liters", "diesel_total_price", "diesel_price_per_liter", "diesel_supplier"]},
    {"key": "diesel_heating", "name": "Heating", "fields": ["diesel_heating_at", "diesel_heating"]}
  ],
  "collections": [
    {
      "name": "Diesel",
      "kind": "list",
      "content_types": ["diesel_reading", "diesel_purchase", "diesel_heating"],
      "views": [
        {
          "name": "Readings",
          "layout": "table",
          "is_default": true,
          "columns": ["$name", "diesel_measured_at", "diesel_stick_cm", "diesel_level_liters", "diesel_fill_percent", "diesel_flag"],
          "query": {"content_type_id": "$diesel_reading", "sort": [{"field": "diesel_measured_at", "direction": "desc"}]}
        },
        {
          "name": "Purchases",
          "layout": "table",
          "columns": ["$name", "diesel_purchased_at", "diesel_bought_liters", "diesel_total_price", "diesel_price_per_liter", "diesel_supplier"],
          "query": {"content_type_id": "$diesel_purchase", "sort": [{"field": "diesel_purchased_at", "direction": "desc"}]}
        },
        {
          "name": "Heating",
          "layout": "table",
          "columns": ["$name", "diesel_heating_at", "diesel_heating"],
          "query": {"content_type_id": "$diesel_heating", "sort": [{"field": "diesel_heating_at", "direction": "desc"}]}
        },
        {
          "name": "Needs a look",
          "layout": "table",
          "columns": ["$name", "diesel_measured_at", "diesel_stick_cm", "diesel_level_liters", "diesel_flag"],
          "query": {"content_type_id": "$diesel_reading", "filter": {"field": "diesel_flag", "op": "eq", "value": "check"}, "sort": [{"field": "diesel_measured_at", "direction": "desc"}]}
        }
      ]
    }
  ]
}
