{
  "name": "Decision routing",
  "description": "Route custom workflow data with a local decision.",
  "definition": {
    "triggers": [
      {
        "type": "manual"
      }
    ],
    "input_schema": {
      "type": "object",
      "properties": {
        "subject": {
          "type": "string"
        },
        "body": {
          "type": "string"
        },
        "customer_tier": {
          "type": "string",
          "default": "standard"
        }
      },
      "required": [
        "subject",
        "body"
      ]
    },
    "output_schema": {
      "type": "object",
      "properties": {
        "route": {
          "type": "string"
        }
      }
    },
    "outputs": {
      "route": "{step:decide.answers.route.selected}"
    },
    "flow": {
      "start": "decide",
      "nodes": {
        "decide": {
          "activity": "ai.decide",
          "inputs": {
            "data": {
              "subject": "{input:subject}",
              "body": "{input:body}",
              "customer_tier": "{input:customer_tier}"
            },
            "questions": [
              {
                "key": "route",
                "type": "choice",
                "instructions": "Which team should handle this request?",
                "options": [
                  {
                    "key": "billing",
                    "text": "Invoices, duplicate charges, payments and refunds"
                  },
                  {
                    "key": "technical",
                    "text": "Product failures, errors and technical troubleshooting"
                  },
                  {
                    "key": "other",
                    "text": "Requests outside billing and technical support"
                  }
                ]
              }
            ]
          },
          "next": {
            "done": "check_route",
            "error": "error"
          }
        },
        "check_route": {
          "activity": "if",
          "inputs": {
            "left": "{step:decide.answers.route.selected}",
            "op": "eq",
            "right": "billing"
          },
          "next": {
            "true": "billing",
            "false": "done"
          }
        },
        "billing": {
          "activity": "end"
        },
        "done": {
          "activity": "end"
        },
        "error": {
          "activity": "fail",
          "inputs": {
            "message": "Decision could not be completed."
          }
        }
      }
    }
  },
  "automatic_enabled": false,
  "manual_enabled": true,
  "state": "published"
}
