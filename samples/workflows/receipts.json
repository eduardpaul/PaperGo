{
  "name": "Index receipts",
  "description": "Indexes each receipt as one chunk of its text plus a model-written summary chunk, so a search for the vendor, the items or the total finds it.",
  "role": "search.content",
  "collection_id": "$LIBRARY",
  "definition": {
    "triggers": [
      {
        "type": "file.added",
        "collection_id": "$LIBRARY",
        "media_types": [
          "application/pdf",
          "image/*"
        ],
        "sources": [
          "upload",
          "webdav",
          "restore",
          "workflow",
          "reindex"
        ]
      },
      {
        "type": "file.updated",
        "collection_id": "$LIBRARY",
        "media_types": [
          "application/pdf",
          "image/*"
        ],
        "sources": [
          "upload",
          "webdav",
          "restore",
          "workflow",
          "reindex"
        ]
      },
      {
        "type": "manual",
        "collection_id": "$LIBRARY"
      }
    ],
    "concurrency": "coalesce",
    "output_schema": {
      "type": "object",
      "required": [
        "blob_id"
      ],
      "properties": {
        "blob_id": {
          "type": "string"
        },
        "text_id": {
          "type": "string"
        },
        "pages": {
          "type": "integer"
        },
        "language": {
          "type": "string"
        },
        "generation": {
          "type": "string"
        },
        "chunks": {
          "type": "integer"
        }
      }
    },
    "outputs": {
      "blob_id": "{step:read.blob_id}",
      "text_id": "{step:read.text_id}",
      "pages": "{step:read.pages}",
      "language": "{step:read.language}",
      "generation": "{step:chunk.generation}",
      "chunks": "{step:chunk.chunks}"
    },
    "flow": {
      "start": "read",
      "nodes": {
        "read": {
          "activity": "document.read_text",
          "inputs": {
            "ocr": "auto",
            "max_pages": 10
          },
          "next": {
            "done": "chunk",
            "no_text": "end",
            "unsupported": "end"
          }
        },
        "chunk": {
          "activity": "search.chunk",
          "inputs": {
            "text_id": "{step:read.text_id}",
            "blob_id": "{step:read.blob_id}",
            "chunker": "whole"
          },
          "next": {
            "done": "summary"
          }
        },
        "summary": {
          "activity": "ai.complete",
          "inputs": {
            "prompt": "Summarize this receipt in two sentences: the vendor, the date, what was bought and the total.",
            "text_id": "{step:read.text_id}",
            "blob_id": "{step:read.blob_id}",
            "max_chars": 8000
          },
          "next": {
            "done": "add"
          }
        },
        "add": {
          "activity": "search.chunk",
          "inputs": {
            "text": "{step:summary.text}",
            "blob_id": "{step:read.blob_id}",
            "chunker": "whole",
            "kind": "summary",
            "generation": "{step:chunk.generation}"
          },
          "next": {
            "done": "embed"
          }
        },
        "embed": {
          "activity": "search.embed",
          "inputs": {
            "generation": "{step:chunk.generation}"
          },
          "next": {
            "done": "publish",
            "deferred": "publish"
          }
        },
        "publish": {
          "activity": "search.publish",
          "inputs": {
            "generation": "{step:chunk.generation}",
            "blob_id": "{step:read.blob_id}"
          },
          "next": {
            "done": "end",
            "stale": "end"
          }
        },
        "end": {
          "activity": "end"
        }
      }
    }
  },
  "automatic_enabled": true,
  "manual_enabled": true,
  "state": "published"
}
